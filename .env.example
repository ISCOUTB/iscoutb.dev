# Copia este archivo a .env (chmod 600). .env nunca se versiona.

DOMINIO=iscoutb.dev
# IP pública de la VM (la de los registros DNS) y su IP privada de la red del proveedor (ip -4 addr).
IP_PUBLICA=
IP_PRIVADA=

# Versiones fijadas para todo el semestre. Actualizar solo entre periodos (ver docs/runbook-docente.md).
DOKPLOY_VERSION=v0.30.8
DOCKER_VERSION=29.8.1

ZONA_HORARIA=America/Bogota
SWAP_GB=4

GITHUB_ORG=ISCOUTB
REPO_PREFIX=AS_202620_

# Se completa después de instalar: Dokploy → Settings → Profile → API/CLI → Generate.
DOKPLOY_URL=https://panel.iscoutb.dev
DOKPLOY_API_KEY=

# Cloudflare → My Profile → API Tokens → Create Token → plantilla "Edit zone DNS",
# zona iscoutb.dev (permisos Zone:DNS:Edit y Zone:Zone:Read). Lo usan 11-dns-cloudflare.sh
# y Traefik (validación DNS-01 del certificado wildcard).
CLOUDFLARE_API_TOKEN=

# Correo de la cuenta ACME de Let's Encrypt (certificado wildcard).
ACME_EMAIL=
